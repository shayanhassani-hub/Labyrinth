{
  "enabledPlugins": {
    "unity@unity-agent-plugin": true
  },
  "env": {
    "MSYS_NO_PATHCONV": "1"
  },
  "permissions": {
    "allow": [
      "Bash(unity status)",
      "Bash(unity status *)",
      "Bash(unity list *)",
      "Bash(unity pipeline list *)",
      "Bash(unity command find_gameobjects *)",
      "Bash(unity command get_*)",
      "Bash(unity command console_status *)",
      "Bash(unity command recompile_status *)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(rm -rf *)"
    ]
  }
}